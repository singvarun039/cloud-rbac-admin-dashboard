# Copy to `.env.prod` on the EC2 host and fill values.
# Do NOT commit real secrets.

# --- Backend (API) ---
NODE_ENV=production

# IMPORTANT: Use the RDS endpoint hostname (not an IP).
# Prefer TLS to RDS.
# Example:
# DATABASE_URL=postgresql://crbad_app:REPLACE_ME@your-db.abcdefg.us-east-1.rds.amazonaws.com:5432/crbad?schema=public&sslmode=require
DATABASE_URL=

# CORS allowlist (single origin or comma-separated list)
# Example: FRONTEND_ORIGIN=http://your-ec2-public-ip
FRONTEND_ORIGIN=

# Must be long random strings (generate with `openssl rand -hex 32`)
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
REFRESH_TOKEN_HASH_SECRET=

# Optional overrides
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d

# Rate limiting (optional)
AUTH_LOGIN_RATE_LIMIT_WINDOW_MS=600000
AUTH_LOGIN_RATE_LIMIT_MAX=10
AUTH_REFRESH_RATE_LIMIT_WINDOW_MS=600000
AUTH_REFRESH_RATE_LIMIT_MAX=30