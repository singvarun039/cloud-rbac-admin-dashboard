# Backend runtime environment variables.
# Copy to .env for local dev (outside Docker). Docker Compose users: see the
# root .env.example instead — this file lists only what backend/src/config/env.ts reads.
# SECURITY: Never commit .env with real values. Only .env.example is committed.

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=4000

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Runtime + `prisma db seed` connection (used by pg.Pool). Must NOT include
# sslmode=require — see src/db/prisma.ts for why.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/crbad?schema=public

# Optional: separate URL used ONLY by the Prisma CLI (migrate/generate).
# Can include sslmode=require. Leave blank to fall back to DATABASE_URL.
PRISMA_DATABASE_URL=

# ---------------------------------------------------------------------------
# JWT / token secrets — REQUIRED in production (app refuses to start without
# real values). Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
# ---------------------------------------------------------------------------
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
REFRESH_TOKEN_HASH_SECRET=change-me-refresh-hash
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d

# ---------------------------------------------------------------------------
# CORS — comma-separated list of allowed browser origins. REQUIRED in production.
# ---------------------------------------------------------------------------
FRONTEND_ORIGIN=http://localhost:5173

# ---------------------------------------------------------------------------
# Rate limiting (all optional — sane defaults in code)
# ---------------------------------------------------------------------------
AUTH_LOGIN_RATE_LIMIT_WINDOW_MS=600000
AUTH_LOGIN_RATE_LIMIT_MAX=10
AUTH_REFRESH_RATE_LIMIT_WINDOW_MS=600000
AUTH_REFRESH_RATE_LIMIT_MAX=30
AI_RATE_LIMIT_WINDOW_MS=300000
AI_RATE_LIMIT_MAX=20

# ---------------------------------------------------------------------------
# AI features (optional — AI routes are disabled/error without a key)
# ---------------------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-nano
OPENAI_API_BASE_URL=https://api.openai.com/v1

# ---------------------------------------------------------------------------
# Seed script overrides (optional — used by `npm run seed`)
# ---------------------------------------------------------------------------
SEED_ADMIN_EMAIL=admin@demo.com
SEED_ADMIN_PASSWORD=Admin@1234
SEED_VIEWER_EMAIL=
SEED_VIEWER_PASSWORD=
SEED_EDITOR_EMAIL=
SEED_EDITOR_PASSWORD=
