# Copy to .env.local for local dev, or set in the Render Static Site dashboard.
# If left empty, the app falls back to same-origin requests (fine when a proxy
# like the Vite dev server or nginx handles /api routing for you).
#
# Production (Render): set this to your deployed backend's public URL.
VITE_API_BASE_URL=https://your-backend.onrender.com
