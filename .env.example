# Root env for Docker Compose (copy to .env)
# SECURITY: Never commit .env or .env.prod to version control.
# Both are excluded by .gitignore. Only .env.example should be committed.

# ---------------------------------------------------------------------------
# Database credentials
# ---------------------------------------------------------------------------
# DB_IDENTIFIER  — RDS instance identifier (informational; shown in AWS console)
#                  Used by Terraform as the RDS resource name.
# DB_USERNAME    — Master username for the Postgres instance.
# DB_PASSWORD    — Master password. REQUIRED. Must be strong in production
#                  (>=20 chars, mixed case, digits, special chars).
#
# SECURITY rules:
#   • Never hardcode these values in source code.
#   • Always source them from this file (dev) or .env.prod / secrets manager (prod).
#   • DATABASE_URL is constructed from the values below — keep all three consistent.
#   • Production values are injected automatically by Terraform (userdata.tftpl);
#     you do NOT need to set them manually on EC2.
#
# Local Docker dev — the "db" service reads POSTGRES_* and the "api" reads DATABASE_URL.
# They must reference the same username/password/db name.
# ---------------------------------------------------------------------------
DB_IDENTIFIER=cloud-rbac-postgres
DB_USERNAME=postgres
DB_PASSWORD=postgres

# Docker Compose Postgres container (must match DB_USERNAME / DB_PASSWORD above)
POSTGRES_DB=crbad
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# API
API_PORT=4000
# ---------------------------------------------------------------------------
# DATABASE_URL — used by the app runtime AND prisma db seed (via pg.Pool).
#
# CRITICAL: Do NOT add sslmode=require here.
#
# Why: pg parses the connection string with pg-connection-string, which turns
# sslmode=require into ssl:{}. pg then merges config as:
#   Object.assign({}, explicitOptions, parsedUrl)
# This means the URL-parsed ssl:{} silently overwrites the explicit
# ssl:{rejectUnauthorized:false} on the Pool, reverting to Node.js TLS defaults
# (rejectUnauthorized:true) — which rejects the AWS RDS cert chain (P1011).
# SSL is instead controlled by the explicit option in src/db/prisma.ts.
#
# Format:         postgresql://<DB_USERNAME>:<DB_PASSWORD>@<host>:5432/<POSTGRES_DB>?schema=public
# Local dev:      host = "db" (Docker Compose service name)
# Production RDS: host = your RDS endpoint  ← no &sslmode=require here
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://postgres:postgres@db:5432/crbad?schema=public

# ---------------------------------------------------------------------------
# PRISMA_DATABASE_URL — used ONLY by the Prisma CLI (migrate deploy, generate).
#
# When this variable is set, prisma.config.ts uses it instead of DATABASE_URL.
# It CAN include sslmode=require because Prisma's Wasm engine handles the
# AWS RDS certificate chain natively without needing rejectUnauthorized:false.
#
# Leave blank in local dev (Prisma CLI will fall back to DATABASE_URL).
# In production (.env.prod), set it to the same host/creds as DATABASE_URL
# but with &sslmode=require appended.
#
# Format (prod): postgresql://<DB_USERNAME>:<DB_PASSWORD>@<RDS_ENDPOINT>:5432/<DB_NAME>?schema=public&sslmode=require
# ---------------------------------------------------------------------------
PRISMA_DATABASE_URL=

# Web
WEB_PORT=5173

# Public URLs (used for docs / optional configs)
API_BASE_URL=http://localhost:4000

# Web <-> API wiring (dev)
# If you keep VITE_API_BASE_URL empty, the web app uses same-origin requests and Vite proxies /api.
VITE_API_BASE_URL=
# Target used by Vite dev-server proxy when running in Docker
VITE_PROXY_TARGET=http://api:4000

# If hot reload is flaky on Windows bind mounts, enable polling:
# CHOKIDAR_USEPOLLING=true

# Optional alternative env name (also enables polling in frontend/vite.config.ts):
# WATCHPACK_POLLING=true

# Optional: enable verbose Vite HMR debug logs in `docker compose logs web`:
# DEBUG=vite:hmr

# CORS allowlist for the API (comma-separated). In Docker dev we default to localhost:WEB_PORT.
FRONTEND_ORIGIN=http://localhost:5173

# ---------------------------------------------------------------------------
# JWT / token secrets
# REQUIRED in production — the app will refuse to start if these are missing
# or still set to the placeholder values below.
# Generate strong secrets with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
# ---------------------------------------------------------------------------
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
REFRESH_TOKEN_HASH_SECRET=change-me-refresh-hash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-nano
OPENAI_API_BASE_URL=https://api.openai.com/v1
