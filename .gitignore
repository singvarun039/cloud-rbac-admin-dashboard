# ── Node ─────────────────────────────────────────────────────────────────────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ── Build outputs ─────────────────────────────────────────────────────────────
backend/dist/
frontend/dist/
frontend/dist-ssr/
build/

# ── TypeScript ────────────────────────────────────────────────────────────────
*.tsbuildinfo

# ── Environment / secrets ─────────────────────────────────────────────────────
.env
.env.*
!.env.example
.env.local
.env.*.local

# Production env files (keep template, ignore actuals)
.env.prod
!.env.prod.template

# ── Logs ──────────────────────────────────────────────────────────────────────
logs/
*.log

# ── Caches ────────────────────────────────────────────────────────────────────
frontend/.vite/
frontend/.eslintcache
.cache/
.turbo/

# ── Test output ───────────────────────────────────────────────────────────────
coverage/
test-results/
playwright-report/
blob-report/

# ── Prisma generated ──────────────────────────────────────────────────────────
backend/src/generated/

# ── Docker ────────────────────────────────────────────────────────────────────
# .dockerignore files are intentionally committed

# ── Terraform ────────────────────────────────────────────────────────────────
**/.terraform/
**/.terraform.lock.hcl
**/*.tfstate
**/*.tfstate.*
**/*.tfvars
**/crash.log
**/crash.*.log
**/tfplan
**/*.tfplan

# ── OS ────────────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
Desktop.ini

# ── Editor ────────────────────────────────────────────────────────────────────
.vscode/
.idea/
*.suo
*.sw?
